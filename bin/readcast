#!/bin/sh
set -eu

script_path=$0
while [ -L "$script_path" ]; do
  script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path=$script_dir/$link_target ;;
  esac
done
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
readcast_home=$(CDPATH= cd -- "$script_dir/.." && pwd -P)

if [ "${1-}" = configure ] || [ "${1-}" = --help ] || [ "${1-}" = -h ]; then
  exec Rscript "$readcast_home/cli.R" "$@"
fi

export READCAST_HOME=$readcast_home
exec Rscript "$readcast_home/app.R" "$@"
